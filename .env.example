# Скопируйте в .env и вставьте токен от @BotFather. Файл .env не попадает в git и в образ.
TELEGRAM_BOT_TOKEN=

# Демо-режим: роли выбираются кнопкой, сообщения для неподключённых сотрудников приходят в ваш чат.
DEMO_MODE=1

# Автоматические рассылки по расписанию (в демо по умолчанию выключены — опрос и сводка по кнопкам).
SCHEDULE=0
PING_AT=09:00
DIGEST_AT=10:00
REMIND_AT=14:00

# Через сколько минут неотвеченный вопрос дилера уходит руководителю.
ESCALATE_MINUTES=120

BOT_TZ=Asia/Yekaterinburg
